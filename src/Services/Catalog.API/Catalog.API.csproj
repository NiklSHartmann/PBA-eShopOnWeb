<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQL Server, ikke SQLite: de to instanser af Catalog.API deler databasen. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Til "dotnet ef migrations add" (Data/Migrations). Kommer ikke med i det byggede program. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Opret, ret og slet kræver et JWT fra PublicApi (samme pakke og version som de andre services). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Logning til konsol + Logstash (se elk/LOGGING.md). -->
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Network" />
    <!-- OpenAPI-beskrivelse og Swagger UI (samme pakke og version som PublicApi). -->
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

</Project>
