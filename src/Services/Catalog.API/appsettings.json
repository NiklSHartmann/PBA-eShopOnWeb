{
  "ConnectionStrings": {
    "CatalogDb": "Server=localhost,14333;Initial Catalog=eShopOnWeb.CatalogService;User Id=sa;Password=@someThingComplicated1234;TrustServerCertificate=true;",
    "MonolithCatalog": "Server=localhost,14333;Initial Catalog=Microsoft.eShopOnWeb.CatalogDb;User Id=sa;Password=@someThingComplicated1234;TrustServerCertificate=true;"
  },
  "Catalog": {
    "InitializeDatabase": true
  },
