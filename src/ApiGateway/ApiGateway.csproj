<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- YARP: Microsofts reverse proxy. Routes og clusters står i appsettings.json under "ReverseProxy". -->
    <PackageReference Include="Yarp.ReverseProxy" />
    <!-- Gatewayen validerer selv JWT'et fra PublicApi (samme pakke og version som services). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Logning til konsol + Logstash (se elk/LOGGING.md). -->
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Network" />
  </ItemGroup>

</Project>
