{
  // Strangler Fig-flaget. false: /api/catalog-* går til monolittens PublicApi. true: til Catalog.API.
  // Web læser samme flag (UseCatalogService). I Docker sættes begge fra USE_CATALOG_SERVICE i .env.
  "UseCatalogService": false,

  "Jwt": {
    "SecretKey": "SecretKeyOfDoomThatMustBeAMinimumNumberOfBytes"
  },

  // Antal kald pr. IP-adresse pr. vindue. Sæt fx Api:PermitLimit til 5 for at se 429 i en demonstration.
  "RateLimits": {
    "Web": { "PermitLimit": 1000, "WindowSeconds": 60 },
    "Api": { "PermitLimit": 100, "WindowSeconds": 60 },
    "Login": { "PermitLimit": 10, "WindowSeconds": 60 }
  },

  "ReverseProxy": {
    "Routes": {
      // Kataloget: samme stier som PublicApi. Alle må læse; opret, ret og slet kræver rollen Administrators.
      "catalog-items-read": {
        "ClusterId": "catalog",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/catalog-items/{**rest}", "Methods": [ "GET" ] }
      },
      "catalog-items-write": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "admin",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/catalog-items/{**rest}", "Methods": [ "POST", "PUT", "DELETE" ] }
      },
      "catalog-brands": {
        "ClusterId": "catalog",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/catalog-brands", "Methods": [ "GET" ] }
      },
      "catalog-types": {
        "ClusterId": "catalog",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/catalog-types", "Methods": [ "GET" ] }
      },

      // Login bliver i monolitten (Identity flyttes ikke), men med en lavere grænse.
      "authenticate": {
        "ClusterId": "publicapi",
        "RateLimiterPolicy": "login",
        "Match": { "Path": "/api/authenticate" }
      },

      // De udskilte services kender ikke /api foran, så det fjernes: /api/orders/12 -> /orders/12.
      "baskets": {
        "ClusterId": "basket",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/baskets/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "orders": {
        "ClusterId": "ordering",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/orders/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "stock": {
        "ClusterId": "inventory",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/stock/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "reservations": {
        "ClusterId": "inventory",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/reservations/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },

      // Alt andet går til monolitten (Web), som i dag. Host-headeren bevares, så Web laver links
      // og redirects (fx til login) til gatewayens adresse og ikke til containerens.
      "web": {
        "ClusterId": "web",
        "RateLimiterPolicy": "web",
        "Match": { "Path": "{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      }
    },

    "Clusters": {
      // To instanser af Catalog.API. Kaldene fordeles på skift (round robin), og hver instans spørges på /health
      // hvert 5. sekund. En instans, der ikke svarer "Healthy", får ingen kald, før den gør det igen.
      "catalog": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": "true",
            "Interval": "00:00:05",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "catalog-1": { "Address": "http://catalogapi-1:8080/" },
          "catalog-2": { "Address": "http://catalogapi-2:8080/" }
        }
      },
      "publicapi": {
        "Destinations": {
          "publicapi": { "Address": "http://eshoppublicapi:8080/" }
        }
      },
      "basket": {
        "Destinations": {
          "basket": { "Address": "http://basketapi:8080/" }
        }
      },
      "ordering": {
        "Destinations": {
          "ordering": { "Address": "http://orderingapi:8080/" }
        }
      },
      "inventory": {
        "Destinations": {
          "inventory": { "Address": "http://inventoryapi:8080/" }
        }
      },
      "web": {
        "Destinations": {
          "web": { "Address": "http://eshopwebmvc:8080/" }
        }
      }
    }
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Network" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        // YARP logger hvert videresendt kald (med hele adressen) på Information; RequestSummaryLogging er nok.
        "Yarp": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Properties": {
      "Application": "ApiGateway"
    }
  },
  "AllowedHosts": "*"
}
