{
  // Kun når gatewayen køres med "dotnet run" uden for Docker (port 5100). Adresserne er services startet
  // lokalt med deres egne launchSettings. Der kører kun én Catalog.API lokalt, så begge destinationer peger på den.
  "ReverseProxy": {
    "Clusters": {
      "catalog": {
        "Destinations": {
          "catalog-1": { "Address": "http://localhost:5600/" },
          "catalog-2": { "Address": "http://localhost:5600/" }
        }
      },
      "publicapi": { "Destinations": { "publicapi": { "Address": "http://localhost:5098/" } } },
      "basket": { "Destinations": { "basket": { "Address": "http://localhost:5400/" } } },
      "ordering": { "Destinations": { "ordering": { "Address": "http://localhost:5300/" } } },
      "inventory": { "Destinations": { "inventory": { "Address": "http://localhost:5500/" } } },
      "web": { "Destinations": { "web": { "Address": "http://localhost:5000/" } } }
    }
  }
}
